{
  "version": "0.1.0",
  "name": "vault_ai",
  "instructions": [
    {
      "name": "initializeVault",
      "accounts": [
        {"name": "vault", "isMut": true, "isSigner": false},
        {"name": "authority", "isMut": true, "isSigner": true},
        {"name": "systemProgram", "isMut": false, "isSigner": false}
      ],
      "args": []
    },
    {
      "name": "setVaultMode",
      "accounts": [
        {"name": "vault", "isMut": true, "isSigner": false},
        {"name": "authority", "isMut": true, "isSigner": true}
      ],
      "args": [
        {"name": "mode", "type": "u8"},
        {"name": "enabled", "type": "bool"}
      ]
    },
    {
      "name": "setAgentAuthority",
      "accounts": [
        {"name": "vault", "isMut": true, "isSigner": false},
        {"name": "authority", "isMut": true, "isSigner": true}
      ],
      "args": [
        {"name": "agentAuthority", "type": "publicKey"}
      ]
    },
    {
      "name": "executeTrade",
      "accounts": [
        {"name": "vault", "isMut": true, "isSigner": false},
        {"name": "authority", "isMut": true, "isSigner": true}
      ],
      "args": [
        {"name": "mint", "type": "publicKey"},
        {"name": "amount", "type": "u64"},
        {"name": "buy", "type": "bool"},
        {"name": "newRiskScore", "type": "u8"}
      ]
    }
  ],
  "accounts": [
    {
      "name": "vault",
      "type": {
        "kind": "struct",
        "fields": [
          {"name": "owner", "type": "publicKey"},
          {"name": "agentAuthority", "type": "publicKey"},
          {"name": "totalValue", "type": "u64"},
          {"name": "riskScore", "type": "u8"},
          {"name": "mode", "type": "u8"},
          {"name": "enabled", "type": "bool"},
          {"name": "holdings", "type": {"vec": {"defined": "TokenHolding"}}},
          {"name": "lastUpdated", "type": "i64"}
        ]
      }
    }
  ],
  "types": [
    {
      "name": "TokenHolding",
      "type": {
        "kind": "struct",
        "fields": [
          {"name": "mint", "type": "publicKey"},
          {"name": "amount", "type": "u64"},
          {"name": "confidence", "type": "u8"}
        ]
      }
    }
  ]
}
