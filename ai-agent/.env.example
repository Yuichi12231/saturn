# Agent environment variables for API keys and wallet secret.
# AGENT_WALLET_SECRET_KEY can be a comma-separated 64-byte array or a base58-encoded secret key.
AGENT_WALLET_SECRET_KEY=your-secret-key-or-array

OPENAI_API_KEY=your-openai-key
HELIUS_API_KEY=your-helius-key
BIRDEYE_API_KEY=your-birdeye-key
